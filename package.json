{
  "name": "andela-hris",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test tests/security.test.js tests/fingerprint.test.js fingerprint-bridge/bridge.test.js",
    "security:rules": "firebase emulators:exec --project demo-ajhris-security --only firestore \"node --test tests/firestore-rules.test.js\"",
    "security:check": "npm run lint && npm test && npm run security:rules"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.12.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
