{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-check-kontrak",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-rekap-cuti",
      "schedule": "45 0 * * *"
    },
    {
      "path": "/api/cron-rekap-cuti",
      "schedule": "0 10 * * *"
    }
  ]
}
