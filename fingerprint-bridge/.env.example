# Salin menjadi .env di komputer kantor. Jangan commit file .env.
FINGERPRINT_DEVICE_IP=192.168.1.234
FINGERPRINT_DEVICE_PORT=4370
FINGERPRINT_BRANCH=CIREBON

# Jika dipasang melalui kode pairing HRIS, installer mengisi dua nilai ini
# dan IP/port/cabang akan diambil otomatis dari konfigurasi pusat.
FINGERPRINT_DEVICE_ID=
FINGERPRINT_DEVICE_TOKEN=

# URL deployment AJ HRIS, tanpa slash di belakang.
HRIS_BASE_URL=https://domain-hris-anda.vercel.app
FINGERPRINT_BRIDGE_SECRET=
# Hanya diperlukan saat menguji URL Preview yang dilindungi Vercel.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Bridge mengirim ulang log beberapa hari terakhir secara idempotent.
FINGERPRINT_LOOKBACK_DAYS=7
# Sinkronisasi otomatis mengecek ulang minimal satu hari sebelum tanggal
# terakhir agar scan pulang yang terlambat tetap memperbarui data kemarin.
FINGERPRINT_RESYNC_DAYS=1
FINGERPRINT_SYNC_INTERVAL_MINUTES=5
FINGERPRINT_REQUEST_TIMEOUT_MS=30000
