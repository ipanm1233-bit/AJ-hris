# Salin menjadi .env di komputer kantor. Jangan commit file .env.
FINGERPRINT_DEVICE_IP=192.168.1.234
FINGERPRINT_DEVICE_PORT=4370

# URL deployment AJ HRIS, tanpa slash di belakang.
HRIS_BASE_URL=https://domain-hris-anda.vercel.app
FINGERPRINT_BRIDGE_SECRET=

# Bridge mengirim ulang log beberapa hari terakhir secara idempotent.
FINGERPRINT_LOOKBACK_DAYS=7
FINGERPRINT_SYNC_INTERVAL_MINUTES=5
FINGERPRINT_REQUEST_TIMEOUT_MS=30000
