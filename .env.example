FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=
GEMINI_API_KEY=
GMAIL_APP_PASSWORD=
GMAIL_USER=
CRON_SECRET=
FINGERPRINT_BRIDGE_SECRET=
FINGERPRINT_TIMEZONE=Asia/Jakarta
FINGERPRINT_MIN_WORK_GAP_MINUTES=120
APP_ORIGIN=
# Set true only after reCAPTCHA Enterprise/App Check is configured and tested.
REQUIRE_APP_CHECK=false
# Attendance migration. Keep "firestore" until validation is complete.
ATTENDANCE_DB_PROVIDER=firestore
# Tracking Sales migration. Enable after 002_sales_tracking.sql is applied.
SALES_TRACKING_DB_PROVIDER=firestore
# Keep both fallbacks true until reconciliation is signed off.
ATTENDANCE_FIRESTORE_FALLBACK=true
SALES_TRACKING_FIRESTORE_FALLBACK=true
SUPABASE_URL=
# Preferred for new Supabase projects (sb_secret_...). Server-side only.
SUPABASE_SECRET_KEY=
# Server-side only. Never expose this key in browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
