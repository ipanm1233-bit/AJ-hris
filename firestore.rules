rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('active', false) == true
        && request.auth.token.get('password_change_required', false) == false;
    }
    function role() { return signedIn() ? request.auth.token.get('role', 'STAFF') : 'ANONYMOUS'; }
    function isHrd() { return role() in ['HRD', 'SUPERADMIN']; }
    function isManagement() { return role() in ['HRD', 'SUPERADMIN', 'GM', 'MANAGER', 'BRANCH MANAGER', 'SPV', 'ATASAN']; }
    function isFinance() { return role() in ['HRD', 'SUPERADMIN', 'GM', 'FINANCE']; }
    function username() { return signedIn() ? request.auth.token.get('username', '') : ''; }
    function nik() { return signedIn() ? request.auth.token.get('nik', '') : ''; }
    function branch() { return signedIn() ? request.auth.token.get('branch', '') : ''; }
    function owns(data) {
      return signedIn() && (
        data.get('uid', '') == request.auth.uid || data.get('user_uid', '') == request.auth.uid || data.get('pemohon_uid', '') == request.auth.uid ||
        (nik() != '' && (data.get('nik', '') == nik() || data.get('nik_karyawan', '') == nik() || data.get('nik_pemohon', '') == nik() || data.get('nik_target', '') == nik())) ||
        (username() != '' && (data.get('username', '') == username() || data.get('username_pemohon', '') == username() || data.get('username_target', '') == username()))
      );
    }
    function sameBranch(data) { return signedIn() && branch() != '' && data.get('cabang', '') == branch(); }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    match /auth_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHrd());
      allow write: if false;
    }
    match /users/{id} { allow read, write: if isHrd(); }
    match /user_permissions/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }

    match /master_karyawan/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isHrd();
    }
    match /master_cabang/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /master_cuti/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /master_kontrak/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow write: if isHrd();
    }
    match /master_kendaraan/{id} {
      allow read: if signedIn();
      allow write: if role() in ['HRD', 'SUPERADMIN', 'GA'];
    }
    match /master_inventory/{id} {
      allow read: if signedIn();
      allow write: if role() in ['HRD', 'SUPERADMIN', 'GA'];
    }

    match /data_pengajuan/{id} {
      allow read: if signedIn() && (isManagement() || isFinance() || owns(resource.data));
      allow create: if signedIn() && owns(request.resource.data);
      allow update: if signedIn() && (
        isManagement() || isFinance() ||
        (owns(resource.data) && onlyChanges(['updated_at', 'lampiran', 'keterangan', 'alasan']))
      );
      allow delete: if isHrd();
    }
    match /data_absensi/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow write: if isHrd();
    }
    match /data_reimbursement/{id} {
      allow read: if signedIn() && (isFinance() || isManagement() || owns(resource.data));
      allow create: if signedIn() && owns(request.resource.data);
      allow update: if isFinance() || isManagement();
      allow delete: if isHrd();
    }
    match /log_kasbon/{id} {
      allow read: if signedIn() && (isFinance() || isManagement() || owns(resource.data));
      allow create: if signedIn() && owns(request.resource.data);
      allow update: if isFinance() || isManagement();
      allow delete: if isHrd();
    }

    match /notifications/{id} {
      allow read: if signedIn() && (owns(resource.data) || isHrd());
      allow create: if signedIn();
      allow update: if signedIn() && owns(resource.data) && onlyChanges(['dibaca', 'read_at']);
      allow delete: if signedIn() && (owns(resource.data) || isHrd());
    }
    match /broadcast/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /app_settings/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /departure_config/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /konfigurasi_email/{id} { allow read, write: if isHrd(); }
    match /form_config/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }

    match /log_sp_konseling/{id} {
      allow read: if isHrd() || (isManagement() && sameBranch(resource.data));
      allow write: if isHrd() || (isManagement() && sameBranch(request.resource.data));
    }
    match /data_pemanggilan/{id} { allow read, write: if isHrd(); }
    match /siklus_karyawan/{id} { allow read, write: if isHrd(); }
    match /evaluasi_kontrak/{id} {
      allow read: if isManagement();
      allow write: if isHrd();
    }
    match /log_offboarding/{id} { allow read, write: if isHrd(); }
    match /sign_documents/{id} {
      allow read: if signedIn() && (isHrd() || owns(resource.data));
      allow write: if isHrd();
    }

    match /log_penilaian_kpi/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow create, update: if signedIn() && (isManagement() || owns(request.resource.data));
      allow delete: if isHrd();
    }
    match /tugas_kpi_360/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow create, update: if signedIn() && (isManagement() || owns(request.resource.data));
      allow delete: if isHrd();
    }
    match /performance_review/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow write: if isManagement();
    }
    match /master_soal_kpi/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /target_bulanan_kpi/{id} {
      allow read: if signedIn();
      allow write: if isManagement();
    }
    match /log_penilaian_harian/{id} {
      allow read: if signedIn() && (isManagement() || owns(resource.data));
      allow create: if signedIn();
      allow update, delete: if isManagement();
    }

    match /log_lembur/{id} {
      allow read: if signedIn() && (isManagement() || isFinance() || owns(resource.data));
      allow create: if signedIn();
      allow update: if isManagement() || isFinance();
      allow delete: if isHrd();
    }
    match /{collectionName}/{id} {
      allow read: if collectionName in [
        'overtime_orders', 'overtime_proposals', 'overtime_approvals',
        'overtime_realizations', 'overtime_calculation_details', 'overtime_payroll_batches'
      ] && signedIn() && (isManagement() || isFinance() || owns(resource.data));
      allow create: if collectionName in ['overtime_orders', 'overtime_proposals', 'overtime_realizations'] && signedIn();
      allow update: if collectionName in [
        'overtime_orders', 'overtime_proposals', 'overtime_approvals',
        'overtime_realizations', 'overtime_calculation_details', 'overtime_payroll_batches'
      ] && (isManagement() || isFinance());
      allow delete: if collectionName in [
        'overtime_orders', 'overtime_proposals', 'overtime_approvals',
        'overtime_realizations', 'overtime_calculation_details', 'overtime_payroll_batches'
      ] && isHrd();
    }
    match /overtime_settings/{id} {
      allow read: if signedIn();
      allow write: if isHrd();
    }
    match /overtime_audit_logs/{id} {
      allow read: if isManagement() || isFinance();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /overtime_export_batches/{id} {
      allow read, write: if isFinance() || isManagement();
    }

    match /{collectionName}/{id} {
      allow read: if collectionName in ['hr_cases', 'hr_case_action_plans', 'hr_case_followups']
        && (isHrd() || (isManagement() && sameBranch(resource.data)));
      allow create, update: if collectionName in ['hr_cases', 'hr_case_action_plans', 'hr_case_followups']
        && (isHrd() || (isManagement() && sameBranch(request.resource.data)));
      allow delete: if collectionName in ['hr_cases', 'hr_case_action_plans', 'hr_case_followups'] && isHrd();
    }
    match /hr_case_audit_logs/{id} {
      allow read: if isHrd();
      allow create: if isManagement();
      allow update, delete: if false;
    }

    match /{collectionName}/{id} {
      allow read: if collectionName in [
        'log_kendaraan_fuel', 'log_kendaraan_service', 'log_kendaraan_compliance',
        'log_inventory_pengambilan', 'stock_opname', 'gimmick_sop', 'kalender_hr_events',
        'uang_makan_expedisi', 'data_training', 'master_reimbursement_type',
        'sales_orders', 'sales_outlets', 'sales_items', 'sales_tasks', 'sales_tracking',
        'kanal_data', 'kanal_checkins', 'sales_odometer'
      ] && signedIn();
      allow create, update: if collectionName in [
        'log_kendaraan_fuel', 'log_kendaraan_service', 'log_kendaraan_compliance',
        'log_inventory_pengambilan', 'stock_opname', 'gimmick_sop', 'kalender_hr_events',
        'uang_makan_expedisi', 'data_training', 'master_reimbursement_type',
        'sales_orders', 'sales_outlets', 'sales_items', 'sales_tasks', 'sales_tracking',
        'kanal_data', 'kanal_checkins', 'sales_odometer'
      ] && signedIn();
      allow delete: if collectionName in [
        'log_kendaraan_fuel', 'log_kendaraan_service', 'log_kendaraan_compliance',
        'log_inventory_pengambilan', 'stock_opname', 'gimmick_sop', 'kalender_hr_events',
        'uang_makan_expedisi', 'data_training', 'master_reimbursement_type',
        'sales_orders', 'sales_outlets', 'sales_items', 'sales_tasks', 'sales_tracking',
        'kanal_data', 'kanal_checkins', 'sales_odometer'
      ] && isHrd();
    }

    match /{collectionName}/{id} {
      allow read, write: if collectionName in [
        'drafts_dokumen', 'custom_doc_templates', 'gdoc_templates'
      ] && isHrd();
      allow read, write: if collectionName == 'interview_scorecards'
        && (isHrd() || role() in ['GM', 'MANAGER']);
      allow read: if collectionName in ['training_plans', 'training_progress'] && signedIn();
      allow create, update: if collectionName in ['training_plans', 'training_progress'] && signedIn();
      allow delete: if collectionName in ['training_plans', 'training_progress'] && isHrd();
    }
    match /user_documents/{id} {
      allow read: if signedIn() && (isHrd() || owns(resource.data));
      allow create: if signedIn() && owns(request.resource.data);
      allow update, delete: if signedIn() && (isHrd() || owns(resource.data));
    }
    match /audit_edit_logs/{id} {
      allow read: if isHrd();
      allow write: if false;
    }

    match /data_rekrutmen/{id} {
      allow read: if isHrd() || isManagement() || resource.data.get('status', '') in ['Open', 'OPEN', 'AKTIF', 'Aktif', 'Dibuka', 'DIBUKA'];
      allow write: if isHrd() || role() in ['GM', 'MANAGER'];
    }
    match /pelamar_ats/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['nama', 'email'])
        && request.resource.data.nama is string && request.resource.data.email is string
        && request.resource.data.nama.size() > 1 && request.resource.data.nama.size() <= 150
        && request.resource.data.email.size() <= 254
        && request.resource.data.get('resume_text', '') is string
        && request.resource.data.get('resume_text', '').size() <= 200000
        && request.resource.data.get('catatan', '') is string
        && request.resource.data.get('catatan', '').size() <= 5000;
      allow read, update, delete: if isHrd() || role() in ['GM', 'MANAGER'];
    }
    match /ats_interviews/{id} { allow read, write: if isHrd() || role() in ['GM', 'MANAGER']; }
    match /ats_rules/{id} { allow read, write: if isHrd(); }
    match /ats_status_history/{id} { allow read, write: if isHrd() || role() in ['GM', 'MANAGER']; }

    match /audit_logs/{id} { allow read, write: if false; }
    match /cron_locks/{id} { allow read, write: if false; }
    match /login_tokens/{id} { allow read, write: if false; }
    match /mail/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
