{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "cabang": { "type": "string" },
        "fcm_token": { "type": "string" }
      },
      "required": ["username", "nama", "role"]
    },
    "DataPengajuan": {
      "title": "DataPengajuan",
      "description": "Employee requests and claim submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama_pemohon": { "type": "string" },
        "nik": { "type": "string" },
        "cabang": { "type": "string" },
        "form_id": { "type": "string" },
        "nama_form": { "type": "string" },
        "status_final": { "type": "string" },
        "tgl": { "type": "string" }
      },
      "required": ["id", "nama_pemohon", "form_id"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications",
      "type": "object",
      "properties": {
        "username_target": { "type": "string" },
        "judul": { "type": "string" },
        "pesan": { "type": "string" },
        "dibaca": { "type": "boolean" },
        "tanggal": { "type": "string" }
      },
      "required": ["username_target", "judul", "pesan"]
    },
    "MasterReimbursementType": {
      "title": "MasterReimbursementType",
      "description": "Reimbursement type configuration and limits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama_jenis": { "type": "string" },
        "plafon_mingguan": { "type": "number" },
        "plafon_bulanan": { "type": "number" },
        "plafon_tahunan": { "type": "number" },
        "hak_akses": { "type": "array", "items": { "type": "string" } },
        "wajib_bukti": { "type": "boolean" },
        "keterangan": { "type": "string" },
        "aktif": { "type": "boolean" }
      },
      "required": ["nama_jenis"]
    },
    "DataReimbursement": {
      "title": "DataReimbursement",
      "description": "Employee financial reimbursement claims",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama_karyawan": { "type": "string" },
        "nik": { "type": "string" },
        "cabang": { "type": "string" },
        "divisi": { "type": "string" },
        "jabatan": { "type": "string" },
        "id_jenis": { "type": "string" },
        "nama_jenis": { "type": "string" },
        "nominal": { "type": "number" },
        "tanggal_pengeluaran": { "type": "string" },
        "keterangan": { "type": "string" },
        "bukti_url": { "type": "string" },
        "status": { "type": "string" },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "paid_at": { "type": "string" },
        "catatan_approval": { "type": "string" }
      },
      "required": ["nama_karyawan", "nama_jenis", "nominal", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts"
    },
    "/data_pengajuan/{pengajuanId}": {
      "schema": { "$ref": "#/entities/DataPengajuan" },
      "description": "Submissions and claims"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notifications"
    },
    "/master_reimbursement_type/{typeId}": {
      "schema": { "$ref": "#/entities/MasterReimbursementType" },
      "description": "Reimbursement type configurations"
    },
    "/data_reimbursement/{reimbursementId}": {
      "schema": { "$ref": "#/entities/DataReimbursement" },
      "description": "Employee reimbursement claims"
    },
    "/master_karyawan/{karyawanId}": {
      "schema": "object",
      "description": "Master employee records"
    },
    "/broadcast/{broadcastId}": {
      "schema": "object",
      "description": "Memos and broadcasts"
    },
    "/gimmick_sop/{sopId}": {
      "schema": "object",
      "description": "SOPs"
    },
    "/login_tokens/{tokenId}": {
      "schema": "object",
      "description": "One-time login tokens"
    }
  }
}
